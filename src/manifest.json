{
  "manifest_version": 3,
  "name": "Leichte Sprache - Überall",
  "version": "1.0",
  "description": "Diese Erweiterung wandelt jeden Text einer Webseite in Leichte Sprache um.",
  "icons": {
    "124": "../icons/reading-book.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.groq.com/*",
    "https://*.wikipedia.org/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Leichte Sprache",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://api.openai.com https://api.groq.com https://huggingface.co https://*.huggingface.co https://*.hf.co https://raw.githubusercontent.com https://github.com"
  },
  "web_accessible_resources": [
    {
      "resources": [ "offscreen.html" ],
      "matches": [ "<all_urls>" ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://www.google.com/search*",
        "*://www.bing.com/search*",
        "*://www.ecosia.org/search*"
      ],
      "css": [
        "easyLanguage.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
